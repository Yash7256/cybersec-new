REDIS_PASSWORD=changeme-generate-a-strong-password
WORKERS=1

# -----------------------------------------------------------------------
# GeoIP — optional token for higher accuracy & rate limits
# ipinfo.io free tier: 50k req/month, no token needed.
# Sign up at https://ipinfo.io/signup for a token to raise the limit.
# -----------------------------------------------------------------------
IPINFO_API_TOKEN=

# -----------------------------------------------------------------------
# Clerk Authentication — required for authenticated API requests
# Get these values from https://dashboard.clerk.com → Your App → API Keys
# -----------------------------------------------------------------------

# Clerk publishable key (safe to expose in frontend bundles)
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key

# Clerk secret key — keep this server-side ONLY, never commit or expose in bundles
CLERK_SECRET_KEY=sk_test_replace_with_your_secret_key

# JWKS endpoint for your Clerk instance, e.g.:
# https://<your-clerk-subdomain>.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://your-clerk-subdomain.clerk.accounts.dev/.well-known/jwks.json

# Issuer URL for your Clerk instance, e.g.:
# https://<your-clerk-subdomain>.clerk.accounts.dev
CLERK_ISSUER=https://your-clerk-subdomain.clerk.accounts.dev

# Expected JWT "aud" (audience) claim. Leave empty to skip audience verification
# (backward compatible; a startup warning is logged when unset).
#
# Clerk session tokens do NOT include "aud" by default. To enable verification:
# 1. In the Clerk Dashboard → JWT Templates, create a template with a custom
#    "aud" claim set to a stable app identifier (e.g. "cybersec-toolkit-api").
# 2. Set CLERK_AUDIENCE to that same value.
# 3. Have the frontend request tokens from that template (getToken({ template: "..." })).
# Docs: https://clerk.com/docs/backend-requests/jwt-templates
CLERK_AUDIENCE=

# Svix signing secret for Clerk webhook delivery. Get it from
# Clerk Dashboard → Webhooks → your endpoint → "Signing secret"
# (format: whsec_...). Used to verify that webhook POSTs really
# come from Clerk. Docs: https://clerk.com/docs/integrations/webhooks
#
# Setup: in the Clerk Dashboard, create a webhook endpoint pointing at
#   https://<your-domain>/api/webhooks/clerk
# and subscribe to these events:
#   session.revoked, session.removed, session.created,
#   user.deleted, user.banned, user.updated
# Delivered via Svix; every event is signature-verified server-side.
CLERK_WEBHOOK_SECRET=

# Vite environment variable for the React frontend (same value as CLERK_PUBLISHABLE_KEY)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_publishable_key
